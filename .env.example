# ─────────────────────────────────────────────────────────────
# Пример конфигурации деплоя для ./deploy.sh
#
# Скопируйте этот файл в .env и отредактируйте под себя:
#   cp .env.example .env
#
# Скрипт автоматически подгружает .env (если он есть).
# Порядок приоритета:
#   1. Переменные окружения (заданные в терминале/системе)
#   2. Значения из .env
#   3. Значения по умолчанию внутри скрипта
#
# Синтаксис:  KEY=VALUE   (без пробелов вокруг "=")
#              # — комментарий
#                   пустые строки игнорируются
#
# ВАЖНО: .env находится в .gitignore и не попадает в git.
#        Этот .env.example — безопасный шаблон для коммита.
#        Реальные пароли/ключи/домены в него НЕ вносите.
# ─────────────────────────────────────────────────────────────

# ── Режим деплоя ─────────────────────────────────────────────
# Если заполнить DEPLOY_HOST — деплой уйдёт на удалённый сервер по SSH.
# Если оставить пустым — разворачиваем на текущей машине.
# Пример:  DEPLOY_HOST=vds.example.com
DEPLOY_HOST=

# ── Веб ──────────────────────────────────────────────────────
# Домен для HTTPS (Caddy автоматически выпустит сертификат Let's Encrypt).
# Для локальной машины без домена оставьте localhost.
DOMAIN=example.com

# Локальный порт, на котором слушает Go-бинарник (внутри машины).
# Caddy будет проксировать с 443 на этот порт.
APP_PORT=8080

# ── Systemd ──────────────────────────────────────────────────
# Имя systemd-сервиса и имя бинарника.
SERVICE_NAME=avakumov
BIN_NAME=server

# Служебный пользователь и группа, из-под которых работает сервис.
APP_USER=avakumov
APP_GROUP=avakumov

# Каталог установки на целевой машине (локальной или удалённой).
INSTALL_DIR=/opt/avakumov

# ── Удалённый VDS/VPS (SSH) ──────────────────────────────────
# Пользователь SSH — root или тот, у кого есть права sudo.
DEPLOY_USER=root
# Порт SSH на удалённой машине.
DEPLOY_SSH_PORT=22
# Куда положить бинарник на удалённом сервере.
# Если не задано — используется INSTALL_DIR.
DEPLOY_REMOTE_DIR=/opt/avakumov

# ── Дополнительные параметры SSH (опционально) ──────────────
# Путь к приватному SSH-ключу. Если пусто — ssh использует ~/.ssh
# (ключ авторизуется через ssh-agent или default).
# DEPLOY_KEY_FILE=/home/user/.ssh/id_ed25519

# PostgreSQL connection string (used by the Go backend)
DATABASE_URL=postgres://user:password@127.0.0.1:5432/dbname?sslmode=disable

# ── DeepSeek (генерация конспектов и резюме через ИИ) ────────
# Ключ API DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# ── Yandex SpeechKit (озвучка конспектов) ───────────────────
# ID каталога Yandex Cloud, где разрешён синтез речи
YANDEX_FOLDER_ID=

# Способ аутентификации №1: IAM-токен
#YANDEX_IAM_TOKEN=

# Способ аутентификации №2: статический API-ключ
#YANDEX_API_KEY=

# Формат аудио: oggopus (по умолчанию), mp3, lpcm
#YANDEX_TTS_FORMAT=oggopus

# Голос синтеза: oksana (по умолчанию), alena, filipp, jane и др.
#YANDEX_TTS_VOICE=oksana

# Скорость речи, например 1.0 или 1.5
#YANDEX_TTS_SPEED=1.0

# ── Агент по задачам (только dev) ───────────────────────────
# В dev-режиме агент забирает задачи из раздела «Приложение»
# с продакшен-сервера и выполняет их в локальном репозитории
# через DeepSeek (нужен DEEPSEEK_API_KEY выше).

# Сервер задач (по умолчанию https://avakumov.ru)
AGENT_SERVER_URL=https://avakumov.ru

# Учётные данные на сервере задач
AGENT_USERNAME=
AGENT_PASSWORD=

# Период опроса в секундах (по умолчанию 120)
#AGENT_POLL_INTERVAL=120

# Корень репозитория (по умолчанию определяется сам: каталог запуска,
# а если это server/ — на уровень выше)
#AGENT_REPO_ROOT=/path/to/avakumov

# Telegram-бот для уведомлений (создать у @BotFather). Без него уведомления в Telegram отключены.
TELEGRAM_BOT_TOKEN=
